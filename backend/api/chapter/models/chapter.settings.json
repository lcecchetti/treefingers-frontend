{
  "kind": "collectionType",
  "collectionName": "chapters",
  "info": {
    "name": "chapter",
    "description": ""
  },
  "options": {
    "increments": true,
    "timestamps": true,
    "draftAndPublish": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "content": {
      "type": "richtext",
      "required": true
    },
    "author": {
      "plugin": "users-permissions",
      "model": "user",
      "via": "chapters"
    },
    "story": {
      "via": "chapters",
      "model": "story"
    },
    "likes": {
      "collection": "like",
      "via": "chapter"
    },
    "parent": {
      "model": "chapter"
    }
  }
}
