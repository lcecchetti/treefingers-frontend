{
  "kind": "collectionType",
  "collectionName": "stories",
  "info": {
    "name": "story",
    "description": ""
  },
  "options": {
    "increments": true,
    "timestamps": true,
    "draftAndPublish": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "maxLength": 80,
      "required": true,
      "minLength": 1
    },
    "author": {
      "via": "stories",
      "plugin": "users-permissions",
      "model": "user"
    },
    "likes": {
      "via": "story",
      "collection": "like"
    },
    "content": {
      "type": "richtext",
      "required": true,
      "minLength": 1
    },
    "tags": {
      "collection": "tag",
      "via": "stories"
    },
    "excerpt": {
      "type": "text",
      "required": false,
      "maxLength": 255
    },
    "children": {
      "collection": "story",
      "via": "parent"
    },
    "parent": {
      "model": "story",
      "via": "children"
    },
    "root": {
      "model": "story"
    },
    "action": {
      "type": "text"
    },
    "isRoot": {
      "type": "boolean",
      "default": true,
      "required": false
    },
    "likesCount": {
      "type": "integer"
    }
  }
}
