{
  "kind": "collectionType",
  "collectionName": "stories",
  "info": {
    "name": "story",
    "description": ""
  },
  "options": {
    "increments": true,
    "timestamps": true,
    "draftAndPublish": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "maxLength": 80
    },
    "author": {
      "plugin": "users-permissions",
      "model": "user",
      "via": "stories"
    },
    "likes": {
      "collection": "like",
      "via": "story"
    },
    "content": {
      "type": "richtext"
    },
    "tags": {
      "via": "stories",
      "collection": "tag"
    },
    "excerpt": {
      "type": "text",
      "required": false,
      "maxLength": 255
    },
    "children": {
      "collection": "story",
      "via": "parent"
    },
    "parent": {
      "model": "story",
      "via": "children"
    },
    "root": {
      "model": "story"
    },
    "action": {
      "type": "text"
    },
    "slug": {
      "type": "string",
      "required": false,
      "unique": true
    }
  }
}
