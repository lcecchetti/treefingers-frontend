{
  "kind": "collectionType",
  "collectionName": "stories",
  "info": {
    "name": "story",
    "description": ""
  },
  "options": {
    "increments": true,
    "timestamps": true,
    "draftAndPublish": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "maxLength": 80
    },
    "author": {
      "plugin": "users-permissions",
      "model": "user",
      "via": "stories"
    },
    "chapters": {
      "collection": "chapter",
      "via": "story"
    },
    "likes": {
      "collection": "like",
      "via": "story"
    },
    "content": {
      "type": "richtext"
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    }
  }
}
