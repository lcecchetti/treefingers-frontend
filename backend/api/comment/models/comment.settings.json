{
  "kind": "collectionType",
  "collectionName": "comments",
  "info": {
    "name": "comment",
    "description": ""
  },
  "options": {
    "increments": true,
    "timestamps": true,
    "draftAndPublish": false
  },
  "attributes": {
    "content": {
      "type": "text",
      "required": true
    },
    "user": {
      "via": "comments",
      "plugin": "users-permissions",
      "model": "user"
    },
    "likes": {
      "collection": "like",
      "via": "comment"
    },
    "story": {
      "via": "comments",
      "model": "story"
    },
    "likesCount": {
      "type": "integer",
      "default": 0
    }
  }
}
